# TradeGPT runtime configuration (copy to .env for local Docker Compose use)
POSTGRES_PASSWORD=change-me
TRADEGPT_EQUITY=2905
TRADEGPT_WORKER_POLL_SECONDS=15

# Market data is intentionally disabled until a real provider is configured.
# The HTTP adapter expects an endpoint returning the QuoteSnapshot contract.
MARKET_DATA_PROVIDER=none
# MARKET_DATA_PROVIDER=http
# MARKET_DATA_BASE_URL=https://provider.example/api/snapshot
# MARKET_DATA_API_KEY_ENV=MARKET_API_KEY
# MARKET_DATA_TIMEOUT_SECONDS=5
# MARKET_API_KEY=do-not-commit-real-secrets

# DATABASE_URL is normally supplied by docker-compose and should not be committed with credentials.
